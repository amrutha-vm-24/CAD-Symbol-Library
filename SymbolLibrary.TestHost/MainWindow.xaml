<Window x:Class="SymbolLibrary.TestHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Symbol Library"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F4F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Symbol Library Panel -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Margin="10"
                Padding="10">

            <DockPanel>
                <TextBlock Text="Symbol Library"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="5,5,5,15"
                           DockPanel.Dock="Top"/>

                <TextBox x:Name="SearchTextBox"
                         Height="32"
                         Margin="5,0,5,10"
                         Padding="8"
                         FontSize="14"
                         ToolTip="Search symbols..."
                         DockPanel.Dock="Top"
                         TextChanged="SearchTextBox_TextChanged"/>  

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoryItemsControl">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Category}"
                                          IsExpanded="True"
                                          Margin="0,3">

                                    <ListBox ItemsSource="{Binding Symbols}" SelectionChanged="SymbolListBox_SelectionChanged" PreviewMouseMove="SymbolListBox_PreviewMouseMove" BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,5" Margin="5,2" Background="#F3F4F6" CornerRadius="4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Drawing Area Placeholder -->
        <!-- Drawing Area -->
        <Border Grid.Column="1"
        Margin="10"
        Background="White"
        BorderBrush="#D1D5DB"
        BorderThickness="1"
        ClipToBounds="True">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected Symbol Name -->
                <TextBlock x:Name="SelectedSymbolName"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="5,5,5,15"/>

                <!-- Symbol Preview -->
                <Border Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="White"
                    Margin="5"
                    ClipToBounds="True">

                    <Image x:Name="SymbolPreviewImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       AllowDrop="True"
                       DragOver="SymbolPreviewImage_DragOver"
                       Drop="SymbolPreviewImage_Drop"
                       PreviewMouseWheel="SymbolPreviewImage_PreviewMouseWheel"/>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Window>

